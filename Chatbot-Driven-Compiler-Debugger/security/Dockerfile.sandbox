FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 10001 -s /usr/sbin/nologin sandboxuser

WORKDIR /sandbox
RUN chown sandboxuser:sandboxuser /sandbox

USER sandboxuser
ENTRYPOINT ["/bin/sh", "-c"]
