# Local Ollama endpoint and context size.
OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_CTX=8192
OLLAMA_CODEGEN_MAX_TOKENS=4096
OLLAMA_MODEL=llama3

# Local models used for suggestions and full-program optimization.
LIVE_MODEL=qwen2.5-coder:3b
CODEGEN_MODEL=qwen2.5-coder:7b

# Optional credentials for other provider integrations; the app currently uses Ollama only.
GROQ_API_KEY=
OPENROUTER_API_KEY=
