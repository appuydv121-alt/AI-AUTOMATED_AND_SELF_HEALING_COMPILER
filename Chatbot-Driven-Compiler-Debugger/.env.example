# ── Primary cloud provider (Gemini - Priority 1) ───────────────────────────
# Get free keys at https://aistudio.google.com/app/apikey
# You can provide multiple API keys from different Gmail accounts!
# If one key hits its quota limit, the app automatically switches to the next account key.
# Format: comma-separated or newline-separated
GEMINI_API_KEY=key_from_gmail1,key_from_gmail2,key_from_gmail3
# Or alternatively:
# GEMINI_API_KEYS=key1,key2,key3

# Gemini model to use.
# Current default (fast, stable): gemini-3.1-flash-lite
# Higher quality option: gemini-3.5-flash
GEMINI_MODEL=gemini-3.1-flash-lite

# ── Local Ollama fallback ─────────────────────────────────────────────────────
OLLAMA_MODEL=llama3

# Fallback models (used when Gemini is unavailable)
LIVE_MODEL=qwen2.5-coder:3b
CODEGEN_MODEL=qwen2.5-coder:7b

# Optional: Ollama server URL (default: http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434

# ── Other cloud providers (optional) ─────────────────────────────────────────
GROQ_API_KEY=
OPENROUTER_API_KEY=
